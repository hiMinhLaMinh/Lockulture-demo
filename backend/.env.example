# Lockulture Backend — Environment Template
# Copy to .env and fill in real values. KHÔNG commit file .env vào Git.

# -------------------------
# Firebase / Google Cloud
# -------------------------

# Path to your Firebase service account JSON key (do not commit this file)
# Download from: Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase project ID (e.g. lockulture-staging)
FIREBASE_PROJECT_ID=

# Cloud Storage bucket name (without gs:// prefix)
# Format: <project-id>.appspot.com or custom bucket name
STORAGE_BUCKET=
STORAGE_TYPE=local

# -------------------------
# Firebase Emulator (dev/test only)
# -------------------------
# Set these when using Firebase Local Emulator Suite.
# Example: localhost:8081 for Firestore, localhost:9099 for Auth
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# -------------------------
# App environment
# -------------------------

# 'development', 'test', or 'production'
ENV=production

# Enable fixture-backed actors in dev/test (must NOT be set in production)
# LOCKULTURE_SOCIAL_FIXTURES=1

# -------------------------
# Cloud Run / server
# -------------------------

# Port for local uvicorn (default 8080)
PORT=8080

# -------------------------
# NOT needed in this service (kept for reference)
# -------------------------
# GOOGLE_MAPS_API_KEY and GEMINI_API_KEY are Phase C (AI worker) only.
# Do not add them here unless deploying the AI worker in the same process.

# Cloud Run, Cloud Tasks and Scheduler
STORAGE_SIGNING_SERVICE_ACCOUNT=
TASK_QUEUE_PATH=
TASK_SERVICE_ACCOUNT=
SCHEDULER_SERVICE_ACCOUNT=
INTERNAL_AUDIENCE=

# Explicit assessment fixture for Emulator or restricted staging
ASSESSMENT_PROVIDER=
FIXTURE_ACTOR_IDS=
# WORKER_FIXTURE_VERDICT=retake_required
# FIXTURE_SUBJECT_NAME=Trống đồng
