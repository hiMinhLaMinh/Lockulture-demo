# Template only; no credentials
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_BASE_URL=https://YOUR_API_HOST/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_PUBLIC_WEB_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_BUCKET
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
# Backend uses Cloud Run service-account ADC, never a bundled private key
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT
FIREBASE_PROJECT_ID=YOUR_PROJECT
STORAGE_BUCKET=YOUR_BUCKET
GEMINI_API_KEY=YOUR_SERVER_KEY
GOOGLE_MAPS_API_KEY=YOUR_SERVER_KEY
GEMINI_MODEL=SET_AFTER_SMOKE_TEST
PROVIDER_MODE=live
CONTRACT_VERSION=1.0.0
GCP_REGION=YOUR_REGION
TASKS_QUEUE=lockulture-ai
WORKER_URL=https://YOUR_API_HOST/internal/jobs
TASK_OIDC_AUDIENCE=https://YOUR_API_HOST
TASK_SERVICE_ACCOUNT=YOUR_TASK_IDENTITY
SCHEDULER_SERVICE_ACCOUNT=YOUR_SCHEDULER_IDENTITY
ALLOWED_WEB_ORIGINS=http://localhost:8081
