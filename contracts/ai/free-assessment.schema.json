{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "free assessment v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "const": "free"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "accepted",
        "retake_required",
        "unidentified",
        "out_of_scope"
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledge": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        {
          "type": "null"
        }
      ]
    },
    "instruction": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "street_sign",
            "food",
            "object"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "locality": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "era_id": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ERA_ANCIENT",
            "ERA_BAC_THUOC",
            "ERA_NGO_DINH_TIEN_LE",
            "ERA_LY_TRAN",
            "ERA_LE_SO",
            "ERA_MAC_LE_TRUNG_HUNG",
            "ERA_TAY_SON",
            "ERA_NGUYEN",
            "ERA_MODERN",
            "ERA_CONTEMPORARY"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "mode",
    "verdict",
    "name",
    "knowledge",
    "instruction",
    "category",
    "canonical_name",
    "locality",
    "era_id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "knowledge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "category": {
            "type": "string",
            "enum": [
              "street_sign",
              "food",
              "object"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "accepted"
          },
          "category": {
            "const": "street_sign"
          }
        }
      },
      "then": {
        "properties": {
          "locality": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  ]
}
