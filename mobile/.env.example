EXPO_PUBLIC_DATA_SOURCE=mock
# Android emulator: http://10.0.2.2:8080/api/v1
# Physical phone: replace localhost with the development computer LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Explicitly opt in when connecting to a development backend with fixture sessions.
EXPO_PUBLIC_SOCIAL_FIXTURES=0
