EXPO_PUBLIC_DATA_SOURCE=api
# Android emulator: http://10.0.2.2:8080/api/v1
# Physical phone: replace localhost with the development computer LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Sprint60 requires verified Firebase Auth; fixture sessions are disabled.
EXPO_PUBLIC_SOCIAL_FIXTURES=0
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
